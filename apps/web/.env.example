# Copy to .env.local to override the basemap. Deploys read the same value from the
# VITE_MAP_STYLE repository secret (Settings > Secrets and variables > Actions).
#
# Any MapLibre style URL works, including styles with pmtiles:// sources. Without
# this variable the app uses OSM Liberty on the PMTiles planet build
# (public/map-styles/osm-liberty.json), which needs no key.
#
# Anything in a VITE_ variable ships to the browser, so restrict any API key to your domains.
# VITE_MAP_STYLE=https://example.com/style.json
