# Copy to .env.local and fill in your key. Deploys read the same value from the
# VITE_MAP_STYLES repository secret (Settings > Secrets and variables > Actions).
#
# Basemaps to choose from, as a JSON list of { name, url }. The first is the default.
# Any MapLibre style URL works, so the provider can be swapped here without code changes.
# Without this variable the app falls back to OpenFreeMap styles, which need no key.
#
# MapTiler: anything in a VITE_ variable ships to the browser, so restrict the key
# to your domains in MapTiler Cloud. Newer -v4 style IDs also exist (e.g. streets-v4).
VITE_MAP_STYLES='[{"name":"Streets","url":"https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY"},{"name":"Outdoor","url":"https://api.maptiler.com/maps/outdoor-v2/style.json?key=YOUR_KEY"},{"name":"Satellite","url":"https://api.maptiler.com/maps/satellite/style.json?key=YOUR_KEY"}]'
